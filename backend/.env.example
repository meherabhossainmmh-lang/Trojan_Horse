# ==============================================================================
# NIRAPOD AI & DATABASE CONFIGURATION FILE (.env)
# ==============================================================================
# Instructions for setup:
# 1. Copy this file to '.env' inside the 'backend/' directory:
#      cp .env.example .env
# 2. Replace the placeholder values below with your real API tokens.
# 3. If tokens are left as placeholders, Nirapod will automatically activate its
#    built-in Intelligent Heuristic Fallback Engine so the application works
#    out-of-the-box for demoing without external API errors.
# ==============================================================================

# --- 1. GROK API / xAI TOKEN (or OpenAI-Compatible API Key) ---
# Insert your Grok API key here for Multi-Modal Vision & NLP Severity Scoring
GROK_API_KEY="INSERT_YOUR_GROK_API_KEY_HERE"
GROK_API_BASE_URL="https://api.x.ai/v1"
GROK_MODEL="grok-beta"

# --- 2. VOYAGE AI TOKEN ---
# Insert your Voyage AI key here for Semantic Duplicate Report Clustering
VOYAGE_API_KEY="INSERT_YOUR_VOYAGE_API_KEY_HERE"
VOYAGE_MODEL="voyage-2"

# --- 3. DATABASE CONNECTION URL ---
# Default is SQLite for instant zero-config testing.
# For PostgreSQL, use: "postgresql://user:password@localhost:5432/nirapod"
DATABASE_URL="sqlite:///./nirapod.db"

# --- 4. APP SECURITY SETTINGS ---
SECRET_KEY="super-secret-key-change-in-production-deployments"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
