# ==============================================================================
# NIRAPOD PATH (SAFE PATH) - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in your tokens below. If left blank or default, Nirapod Path
#    automatically activates fallback client/demo modes so you can test and demo
#    all features without API key errors.
# ==============================================================================

# 1. NEON / POSTGRES DATABASE URL
DATABASE_URL=

# 2. EDGESTORE CONFIGURATION (Photo Uploads)
EDGE_STORE_ACCESS_KEY=
EDGE_STORE_SECRET_KEY=

# 3. PUSHER CONFIGURATION (Realtime SOS Alerts to City Corporation)
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=

# 4. AUTH SESSION COOKIE SECRET
SESSION_SECRET=super-secret-key-change-in-prod-deployment
