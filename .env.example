# ==============================================================================
# NIRAPOD PATH (SAFE PATH) - COMPLETE ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in your root folder:
#      cp .env.example .env
# 2. Fill in any tokens you have below.
# 3. GOOD NEWS: You do NOT need all of these keys to run or demo the project!
#    Any key you leave blank automatically activates Nirapod's built-in fallback
#    so that every single feature works 100% out-of-the-box!
# ==============================================================================

# --- 1. AI API KEYS (Groq / Grok & Voyage AI) ---
# For AI Multi-Modal Hazard Analyzer & Severity Scoring
GROK_API_KEY="INSERT_YOUR_GROK_API_KEY_HERE"
GROK_API_BASE_URL="https://api.x.ai/v1"
GROK_MODEL="grok-beta"

# For Semantic Duplicate Report Detection
VOYAGE_API_KEY="INSERT_YOUR_VOYAGE_API_KEY_HERE"
VOYAGE_MODEL="voyage-2"

# --- 2. NEON / POSTGRES DATABASE URL ---
# Connection string for Neon Postgres (or leave blank for standalone demo mode)
DATABASE_URL=

# --- 3. EDGESTORE CONFIGURATION (Photo Uploads) ---
EDGE_STORE_ACCESS_KEY=
EDGE_STORE_SECRET_KEY=

# --- 4. PUSHER CONFIGURATION (Realtime SOS Alerts to City Corporation) ---
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# --- 5. AUTH SESSION COOKIE SECRET ---
SESSION_SECRET=super-secret-key-change-in-prod-deployment
